# Copy this file to .env and fill in your DeepSeek API key.
# Run the CLI from this directory to load .env automatically.
# Exported environment variables take precedence over these values.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# API: load this file explicitly with uvicorn --env-file .env.
# Local sources must be registered by the server, with absolute paths.
EXTRACT_LOCAL_REPOSITORIES={}
# Comma-separated Git remote hostnames. No hosting API is required.
EXTRACT_REMOTE_HOSTS=
EXTRACT_TIMEOUT_SECONDS=120
EXTRACT_MAX_CONCURRENCY=2
EXTRACT_MAX_INPUT_CHARS=60000
EXTRACT_MAX_OUTPUT_TOKENS=8000
# EXTRACT_CATALOG=/absolute/path/to/reviewed-catalog.json
