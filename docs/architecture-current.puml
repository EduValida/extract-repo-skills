@startuml
title Arquitetura — preparação de evidências de contribuições Git
left to right direction
skinparam shadowing false
skinparam roundcorner 12
skinparam nodesep 10
skinparam ranksep 12
skinparam defaultFontSize 12
skinparam ArrowColor #9CA3AF
skinparam rectangle {
  BackgroundColor #E7EFE7
  BorderColor #C5DCC5
  FontColor #365B36
  FontColor<<principal>> white
}
hide stereotype

rectangle "Entrada\nGit + e-mails do autor\nReferência e limites" as Input <<principal>> #182540
rectangle "Seleção e coleta\nContribuições do autor\nContexto e métricas" as Collect

' O bloco embutido mantém os artefatos verticais e as setas nas bordas do pacote.
rectangle Bundle #F8FAFC [
<b>Pacote estático</b>
{{uml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam roundcorner 12
skinparam nodesep 10
skinparam ranksep 10
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor #E7EFE7
  BorderColor #C5DCC5
  FontColor #365B36
}
rectangle "Histórico e autoria\ngit-log.json" as Log
rectangle "Alterações e evidências\ngit-diff.json" as Diff
rectangle "Linguagens e linhas\nlanguages.json" as Languages
rectangle "Estrutura e configuração\nproject-context.json" as Project
rectangle "Contexto e funções\ncontribution-context.json" as Context
rectangle "Manifesto\nRecorte, cobertura e hashes" as Manifest #E2E8F0
Log -[hidden]-> Diff
Diff -[hidden]-> Languages
Languages -[hidden]-> Project
Project -[hidden]-> Context
Context -[hidden]-> Manifest
}}
]

rectangle "Catálogo versionado\nCompetências e critérios" as Catalog
rectangle "Preparação da entrada\nPacote + catálogo + instruções" as Prepare <<principal>> #182540
rectangle "Análise semântica com LLM\nOutro projeto" as External #F1F5F9

Input --> Collect
Collect --> Bundle
Bundle --> Prepare
Catalog -right-> Prepare
Prepare ..> External : pacote preparado
@enduml
