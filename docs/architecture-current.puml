@startuml
' Título intencionalmente fora da imagem para não duplicar o título do slide.
' Para usar o diagrama fora de uma apresentação, descomente a linha abaixo.
' title Arquitetura — preparação de evidências de contribuições Git

left to right direction
skinparam shadowing false
skinparam roundcorner 10
skinparam nodesep 18
skinparam ranksep 35
skinparam defaultFontSize 13
skinparam defaultTextAlignment center
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 11
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  FontColor #334155
  BorderThickness 1
  FontColor<<principal>> #FFFFFF
  BackgroundColor<<principal>> #182540
  BorderColor<<principal>> #182540
  FontColor<<stage>> #365B36
  BackgroundColor<<stage>> #E7EFE7
  BorderColor<<stage>> #C5DCC5
  BackgroundColor<<manifest>> #E2E8F0
  BackgroundColor<<reference>> #E2E8F0
  BorderColor<<reference>> #CBD5E1
  FontColor<<reference>> #334155
  BorderColor<<external>> #94A3B8
  BackgroundColor<<external>> #F8FAFC
  FontColor<<external>> #64748B
  BorderStyle<<external>> dashed
}
skinparam package {
  BackgroundColor #F1F5F9
  BorderColor #CBD5E1
  FontColor #334155
  FontStyle bold
  BorderThickness 1
}
skinparam frame {
  BorderColor #94A3B8
  BorderThickness 1
  FontColor #475569
  FontStyle bold
  FontSize 12
  BackgroundColor transparent
}
hide stereotype

frame "Este projeto" as Scope {
  rectangle "<b>Entrada</b>\nGit + e-mails do autor\nReferência e limites" as Input <<principal>>
  rectangle "<b>Seleção e coleta</b>\nContribuições do autor\nContexto e métricas" as Collect <<stage>>

  package "Pacote estático · 5 artefatos + manifesto" as Bundle {
    rectangle "<b>git-log.json</b>\nHistórico e autoria" as Log
    rectangle "<b>git-diff.json</b>\nAlterações e evidências" as Diff
    rectangle "<b>languages.json</b>\nLinguagens e linhas" as Lang
    rectangle "<b>project-context.json</b>\nEstrutura e configuração" as Proj
    rectangle "<b>contribution-context.json</b>\nContexto e funções" as Ctx
    rectangle "<b>Manifesto</b>\nRecorte, cobertura e hashes" as Man <<manifest>>

    ' As arestas ocultas apenas organizam os cartões em 3 colunas × 2 linhas.
    Proj -[hidden]right-> Log
    Ctx -[hidden]right-> Diff
    Man -[hidden]right-> Lang
    Proj -[hidden]down-> Ctx
    Ctx -[hidden]down-> Man
  }

  rectangle "<b>Catálogo versionado</b>\nCompetências e critérios" as Catalog <<reference>>
  rectangle "<b>Preparação local</b>\nPacote + catálogo + instruções" as Prepare <<principal>>
}

rectangle "<b>Análise semântica com LLM</b>\nProjeto consumidor" as External <<external>>

Input --> Collect
Collect --> Bundle
Bundle --> Prepare
Catalog -right-> Prepare
Prepare ..> External : pacote preparado
@enduml
